{
  "name": "@solar/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": { "types": "./src/index.ts", "default": "./src/index.ts" },
    "./operations": { "types": "./src/index.ts", "default": "./src/index.ts" },
    "./bridge": { "types": "./src/bridge.ts", "default": "./src/bridge.ts" },
    "./generated/graphql": { "types": "./src/generated/graphql.ts", "default": "./src/generated/graphql.ts" }
  },
  "scripts": {
    "codegen": "graphql-codegen --config codegen.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": { "@graphql-typed-document-node/core": "3.2.0" },
  "devDependencies": {
    "@graphql-codegen/cli": "6.0.0",
    "@graphql-codegen/typescript": "5.0.10",
    "@graphql-codegen/typescript-operations": "5.1.0",
    "@graphql-codegen/typed-document-node": "6.1.8",
    "graphql": "16.14.2",
    "typescript": "6.0.3"
  }
}
