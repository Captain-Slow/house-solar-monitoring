{
  "name": "backend",
  "version": "0.1.0",
  "description": "House solar monitoring backend (read-only Modbus collector, accounting, GraphQL)",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint": "oxlint --type-aware src/ test/",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:int": "vitest run --config ./vitest.config.int.ts",
    "probe": "nest build && node dist/cli/probe.js",
    "replay": "nest build && node dist/cli/replay-server.js",
    "analyze": "nest build && node dist/cli/analyze-capture.js",
    "export-samples": "nest build && node dist/cli/export-samples.js",
    "schema": "nest build && node dist/cli/schema.js"
  },
  "dependencies": {
    "@apollo/server": "5.5.1",
    "@as-integrations/express5": "1.1.2",
    "@nestjs/apollo": "14.0.3",
    "@nestjs/common": "12.1.3",
    "@nestjs/core": "12.1.3",
    "@nestjs/graphql": "14.0.3",
    "@nestjs/platform-express": "12.1.3",
    "@nestjs/terminus": "12.1.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "decimal.js": "10.6.0",
    "graphql": "16.14.2",
    "graphql-scalars": "2.0.1",
    "luxon": "3.7.2",
    "modbus-serial": "8.0.25",
    "nestjs-pino": "5.3.1",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "prisma": "7.10.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "selfsigned": "5.5.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.8",
    "@nestjs/schematics": "12.0.0",
    "@nestjs/testing": "12.1.3",
    "@types/luxon": "3.7.6",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2001",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
